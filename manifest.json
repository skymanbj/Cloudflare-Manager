{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Cloudflare Manager"
  },
  "background": {
    "service_worker": "background.js"
