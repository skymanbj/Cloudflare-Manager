    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Cloudflare Manager",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "version": "2.2.0"
}