{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Cloudflare Manager"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "专业的 Cloudflare DNS 记录管理工具。支持多账户、批量操作、数据导出、资源备注。",
  "host_permissions": [
    "https://api.cloudflare.com/*",
    "https://api.github.com/*",
    "https://dash.cloudflare.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Cloudflare Manager",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": ["*://dash.cloudflare.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "version": "2.5.0"
}